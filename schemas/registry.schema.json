{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sina-med.github.io/brain/schemas/registry.schema.json",
  "title": "ID registry entry",
  "type": "object",
  "required": ["id", "type", "by", "status", "first_seen", "updated"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "by": { "type": "string" },
    "status": { "enum": ["active", "merged", "retired"] },
    "redirect": { "type": "string" },
    "first_seen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
